# ──────────────────────────────────────────────
# Renomeie este arquivo para ".env" antes de usar
# e troque TODOS os valores "changeme" por senhas fortes
# ──────────────────────────────────────────────

# Banco de dados do Nextcloud
NEXTCLOUD_DB_ROOT_PASSWORD=changeme_root_super_secreta
NEXTCLOUD_DB_PASSWORD=changeme_db_super_secreta

# Usuário admin do Nextcloud (criado automaticamente no primeiro start)
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=changeme_admin_super_secreta

# IP do seu notebook na rede local (descubra com: ip a)
SERVER_IP=192.168.1.100

# Caminho no HOST (seu notebook) onde estão os arquivos de música
# Pode ser um pendrive, HD externo ou pasta normal
MUSIC_PATH=/home/seu-usuario/musica
